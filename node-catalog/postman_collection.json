{
  "info": {
    "name": "Catalog & Inventory (Node) — Prueba técnica SYC",
    "description": "Colección de la API de catálogo e inventario. Requiere el servicio corriendo (docker-compose up, o npm run dev) en {{baseUrl}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
      }
    },
    {
      "name": "Productos",
      "item": [
        {
          "name": "Listar productos",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products?page=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "name", "value": "", "disabled": true, "description": "Filtro por nombre (ILIKE)" },
                { "key": "minPrice", "value": "", "disabled": true },
                { "key": "maxPrice", "value": "", "disabled": true },
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Ver producto por id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/products/1", "host": ["{{baseUrl}}"], "path": ["api", "products", "1"] }
          }
        },
        {
          "name": "Crear producto",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"SKU-004\",\n  \"name\": \"Webcam HD\",\n  \"price\": 120000,\n  \"stock\": 30\n}"
            }
          }
        },
        {
          "name": "Crear producto — SKU duplicado (409 esperado)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"SKU-001\",\n  \"name\": \"Duplicado a propósito\",\n  \"price\": 1000,\n  \"stock\": 5\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Inventario",
      "item": [
        {
          "name": "Reservar stock",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/inventory/reserve", "host": ["{{baseUrl}}"], "path": ["api", "inventory", "reserve"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"productId\": 1, \"quantity\": 2 }\n  ]\n}"
            }
          }
        },
        {
          "name": "Reservar stock — insuficiente (409 esperado)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/inventory/reserve", "host": ["{{baseUrl}}"], "path": ["api", "inventory", "reserve"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"productId\": 1, \"quantity\": 999999 }\n  ]\n}"
            }
          }
        },
        {
          "name": "Liberar stock",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/inventory/release", "host": ["{{baseUrl}}"], "path": ["api", "inventory", "release"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"productId\": 1, \"quantity\": 2 }\n  ]\n}"
            }
          }
        }
      ]
    }
  ]
}
